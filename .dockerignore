# Offline (perimeter) build kit: only offline/kit/context is consumed inside
# the build (COPY offline/ in Dockerfile.web). The saved base images and the
# vendor tarball are used by scripts on the host — keep them out of the
# context so backend/web builds do not upload gigabytes for nothing.
offline/kit/images
offline/kit/go-vendor.tar.gz
