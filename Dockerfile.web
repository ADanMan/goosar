# --- CLI binaries served by the web app ---
# Self-hosted installs cannot fetch the CLI from GitHub: the repository is
# private, so both raw.githubusercontent.com and the release assets 404 for
# users. Instead the web app serves its own installer (apps/web/public/install.sh)
# plus the tarballs it downloads, so a self-hosted Goosar is self-sufficient.
# Costs ~4 cross-compiles and roughly 60-100 MB in the final image; that is the
# price of an install path that works without any public artifact hosting.
#
# The image ARGs and GOOSAR_OFFLINE_BUILD exist for the offline (perimeter)
# build kit — see SELF_HOSTING.md, «Закрытый контур (offline-поставка)». Their defaults keep the online
# build identical to the pre-kit behavior: same base images, same commands.
#
# Pinned by digest (supply-chain: a tag is mutable, a digest is not — see #137).
# The tag stays in the ref for readability; Docker resolves the digest. Both
# digests below are the multi-arch INDEX digest (covers linux/amd64 +
# linux/arm64), not a per-platform manifest digest, so both arches still
# build. To update: `docker buildx imagetools inspect <image>:<tag>` and copy
# the top-level "Digest:" line. offline/offline-kit.test.sh asserts every
# default here stays digest-pinned, and that GO_IMAGE stays identical to
# Dockerfile's.
ARG GO_IMAGE=golang:1.26-alpine@sha256:28d89ee9cc0ff9fec75c82ca201e6bf7fdf9a679d4b7b24dfa04f2bb766bb468
ARG NODE_IMAGE=node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32

FROM ${GO_IMAGE} AS cli

# GOOSAR_OFFLINE_BUILD=1 skips every network-touching step. The offline kit
# supplies server/vendor/ (go builds with -mod=vendor automatically when the
# vendor directory exists) plus the /offline payload used by the node stages.
ARG GOOSAR_OFFLINE_BUILD=0

WORKDIR /src

COPY server/go.mod server/go.sum ./server/
RUN if [ "$GOOSAR_OFFLINE_BUILD" != "1" ]; then cd server && go mod download; fi
COPY server/ ./server/

ARG NEXT_PUBLIC_APP_VERSION=dev
# Same stamps Dockerfile, .goreleaser.yml and the kit-cli build in
# scripts/release-local.sh use: without them `goosar --version` reports
# "commit: unknown, built: unknown" for every install that came from /cli/*
# (issue #525). The defaults keep non-release builds working.
ARG COMMIT=unknown
ARG DATE=unknown

# One tarball per platform, laid out exactly as install.sh / install.ps1
# expect: a single `goosar` (`goosar.exe` on Windows — #567, extracted by
# the tar.exe Windows 10 ships) at the archive root, plus a checksums.txt they
# verify against.
RUN set -eux; \
    mkdir -p /out/cli; \
    for target in darwin/amd64 darwin/arm64 linux/amd64 linux/arm64 windows/amd64; do \
      os="${target%/*}"; arch="${target#*/}"; \
      bin=goosar; [ "$os" = windows ] && bin=goosar.exe; \
      mkdir -p "/tmp/$os-$arch"; \
      cd /src/server && CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" \
        go build -ldflags "-s -w -X main.version=${NEXT_PUBLIC_APP_VERSION} -X main.commit=${COMMIT} -X main.date=${DATE}" \
        -o "/tmp/$os-$arch/$bin" ./cmd/goosar; \
      tar -czf "/out/cli/goosar-cli-$os-$arch.tar.gz" -C "/tmp/$os-$arch" "$bin"; \
    done; \
    cd /out/cli && sha256sum *.tar.gz > checksums.txt

# T-18: hermes agent-runtime artifacts, served next to the goosar CLI
# tarballs under /cli/. hermes-agent is a separate repository, so
# unlike `goosar` above it cannot be cross-compiled here — this only
# packages artifacts that were already built and staged into
# GOOSAR_HERMES_DIST_DIR (same env var apps/desktop/scripts/bundle-agent.mjs
# uses to locate a hermes-agent build). hermes-agent's own
# scripts/build-artifact.sh produces dist/ entries as either unpacked
# hermes-<version>-<os>-<arch>/ directories or already-packed
# hermes-<version>-<os>-<arch>.tar.gz archives; scripts/stage-agent-artifacts.sh
# accepts both, normalizes arch (x86_64|amd64->amd64, arm64|aarch64->arm64),
# keeps the newest dotted version when two versions target one platform,
# and republishes each under the stable name install.sh/install.ps1 request:
# hermes-<os>-<arch>.tar.gz.
#
# GOOSAR_HERMES_DIST_DIR is a path relative to the build context (repo
# root) and is fed to the dist as-is. Empty (the default), missing, or
# containing no hermes-* entries all skip this step without failing the
# build — a deployment without agent artifacts still gets a working goosar
# CLI install.
ARG GOOSAR_HERMES_DIST_DIR=""
RUN --mount=type=bind,source=.,target=/host-context \
    set -eux; \
    dist=""; \
    if [ -n "$GOOSAR_HERMES_DIST_DIR" ] && [ -d "/host-context/$GOOSAR_HERMES_DIST_DIR" ]; then \
      dist="/host-context/$GOOSAR_HERMES_DIST_DIR"; \
    fi; \
    if [ -n "$dist" ]; then \
      /host-context/scripts/stage-agent-artifacts.sh "$dist" /out/cli; \
    else \
      echo "[cli] no hermes agent artifacts found in GOOSAR_HERMES_DIST_DIR='$GOOSAR_HERMES_DIST_DIR'; skipping (goosar CLI is unaffected)" >&2; \
    fi

# --- Dependencies ---
FROM ${NODE_IMAGE} AS deps

ARG GOOSAR_OFFLINE_BUILD=0

WORKDIR /app

# Offline kit payload (pnpm store, corepack cache, vendored Google Fonts).
# The committed offline/ skeleton is a few KB of scripts and docs, so online
# builds copy nothing meaningful. Build stages only — the runtime image below
# never sees /offline.
COPY offline/ /offline/
# Seed corepack's default cache so every later corepack/pnpm invocation in
# this stage resolves the pinned pnpm without touching the npm registry.
RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then \
      mkdir -p /root/.cache/node && \
      cp -R /offline/kit/context/corepack /root/.cache/node/corepack; \
    fi

# Copy workspace config and all package.json files for dependency resolution
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/
COPY packages/views/package.json packages/views/
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/

RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then export COREPACK_ENABLE_NETWORK=0; fi; \
    corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate
RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then \
      pnpm install --frozen-lockfile --offline --store-dir /offline/kit/context/pnpm-store; \
    else \
      pnpm install --frozen-lockfile; \
    fi

# --- Build ---
FROM ${NODE_IMAGE} AS builder

ARG GOOSAR_OFFLINE_BUILD=0

WORKDIR /app

# Offline kit payload again — this is a fresh node image, see the deps stage.
COPY offline/ /offline/
RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then \
      mkdir -p /root/.cache/node && \
      cp -R /offline/kit/context/corepack /root/.cache/node/corepack; \
    fi

# Activate the same pnpm version declared by the repository before the
# offline frozen install validates package-manager metadata in pnpm-lock.yaml.
COPY package.json ./
RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then export COREPACK_ENABLE_NETWORK=0; fi; \
    corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate

# Copy installed dependencies (preserves pnpm symlink structure)
COPY --from=deps /app ./

# Copy source
COPY package.json turbo.json pnpm-workspace.yaml ./
COPY apps/web/ apps/web/
COPY packages/ packages/

# Re-link after source overlay (fixes any symlinks overwritten by COPY).
# Offline builds must name the same store dir the deps stage installed with:
# pnpm records it in node_modules/.modules.yaml and refuses a mismatch.
RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then \
      pnpm install --frozen-lockfile --offline --store-dir /offline/kit/context/pnpm-store; \
    else \
      pnpm install --frozen-lockfile --offline; \
    fi

ARG NEXT_PUBLIC_APP_VERSION=dev
ENV NEXT_PUBLIC_APP_VERSION=$NEXT_PUBLIC_APP_VERSION
ENV STANDALONE=true

# Build the web app (standalone output for minimal runtime). Offline builds
# resolve next/font/google from the vendored font payload instead of
# fonts.googleapis.com and keep Next's telemetry from phoning home.
RUN if [ "$GOOSAR_OFFLINE_BUILD" = "1" ]; then \
      export NEXT_FONT_GOOGLE_MOCKED_RESPONSES=/offline/kit/context/fonts/mocked-responses.js \
             NEXT_TELEMETRY_DISABLED=1; \
    fi; \
    pnpm --filter @goosar/web build

# --- Runtime ---
FROM ${NODE_IMAGE} AS runner

# libcrypto3/libssl3 3.5.7-r0 ship in every node:22-alpine and node:24-alpine
# tag as of 09.09.2026 and are a trivy HIGH (#520); Alpine's repository has
# 3.5.8-r0, upstream just has not rebuilt the node image against it (there is
# no node:*-alpine3.25 tag either). Upgrade the two packages here rather than
# wait for a base rebuild.
#
# Two things this step must not do quietly:
#
#  1. Succeed while the mirror served an OpenSSL still below the floor. The
#     packages are NOT version-pinned (a pin would break the day Alpine ships
#     3.5.9), so the version is read back and compared instead — a build whose
#     repository answered but left the vulnerable version fails here.
#  2. Pretend the perimeter got the same image. An offline build runs with
#     --network=none and has no repository to reach, so `apk upgrade` cannot
#     succeed and must not fail the build; the kit's digest-pinned base decides
#     which OpenSSL ships, which today means 3.5.7-r0 and the #520 HIGH still
#     open in an image built from source inside the perimeter. Carry the
#     prebuilt release images instead when the delivery must scan clean — see
#     «Сборка OpenSSL в закрытом контуре» in SELF_HOSTING.md.
#
# Deliberately NOT guarded by an ARG GOOSAR_OFFLINE_BUILD — reachability is
# the actual condition, and offline/offline-kit.test.sh counts the offline ARG
# declarations in this file.
RUN set -eu; \
    GOOSAR_OPENSSL_FLOOR="3.5.8"; \
    installed_libssl3() { \
      awk '/^P:libssl3$/ { found = 1 } found && /^V:/ { print substr($0, 3); exit }' \
        /lib/apk/db/installed; \
    }; \
    if apk upgrade --no-cache libssl3 libcrypto3; then \
      version="$(installed_libssl3)"; \
      if [ "$(printf '%s\n%s\n' "$GOOSAR_OPENSSL_FLOOR" "${version%%-*}" | sort -V | head -n1)" \
           != "$GOOSAR_OPENSSL_FLOOR" ]; then \
        echo "ERROR: libssl3 $version is below $GOOSAR_OPENSSL_FLOOR after apk upgrade (#520)" >&2; \
        exit 1; \
      fi; \
    else \
      echo "WARN: could not upgrade libssl3/libcrypto3 — no Alpine repository reachable (offline build?); shipping the base image OpenSSL" >&2; \
    fi; \
    echo "libssl3 in this image: $(installed_libssl3)"

# npm and corepack ship with the node base and are dead weight here: the
# runtime serves a prebuilt Next.js standalone bundle with `node server.js`
# and installs nothing. Their bundled dependencies (tar, pacote, sigstore,
# brace-expansion, picomatch, ip-address) were every remaining trivy HIGH in
# the v1.0.0 web image (#520), so delete them instead of carrying a package
# manager nobody runs.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
    /opt/yarn-* /usr/local/bin/yarn /usr/local/bin/yarnpkg

WORKDIR /app

ENV NODE_ENV=production
ENV REMOTE_API_URL=http://backend:8080

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy standalone output (includes traced node_modules)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone ./
# Copy static files (not included in standalone)
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static ./apps/web/.next/static
# Copy public assets
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public ./apps/web/public
# CLI tarballs + checksums, served next to public/install.sh at /cli/*
COPY --from=cli --chown=nextjs:nodejs /out/cli ./apps/web/public/cli
COPY --chown=nextjs:nodejs THIRD_PARTY_NOTICES.md LICENSE ./

USER nextjs

EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

CMD ["node", "apps/web/server.js"]
