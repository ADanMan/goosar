{
  "name": "@goosar/desktop",
  "productName": "Goosar",
  "version": "1.0.0",
  "private": true,
  "description": "Goosar Desktop — native desktop client for the Goosar platform.",
  "homepage": "https://goosar.ru",
  "repository": {
    "type": "git",
    "url": "https://github.com/adanman/goosar.git",
    "directory": "apps/desktop"
  },
  "author": {
    "name": "Goosar",
    "email": "support@goosar.ru"
  },
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "bundle-cli": "node scripts/bundle-cli.mjs",
    "bundle-agent": "node scripts/bundle-agent.mjs",
    "bundle-ca": "node scripts/bundle-ca.mjs",
    "bundle-mcp-servers": "node scripts/bundle-mcp-servers.mjs",
    "verify-mcp-server": "node scripts/verify-mcp-server.mjs",
    "bundle-skills": "node scripts/bundle-skills.mjs",
    "verify-skill": "node scripts/verify-skill.mjs",
    "bundle-preset-overlay": "node scripts/bundle-preset-overlay.mjs",
    "bundle-deployment-defaults": "node scripts/bundle-deployment-defaults.mjs",
    "brand-dev-electron": "node scripts/brand-dev-electron.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:staging": "node scripts/dev.mjs --mode staging",
    "build": "pnpm run bundle-cli && pnpm run bundle-agent && pnpm run bundle-ca && pnpm run bundle-mcp-servers && pnpm run bundle-skills && pnpm run bundle-preset-overlay && pnpm run bundle-deployment-defaults && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "preview": "electron-vite preview",
    "package": "node scripts/package.mjs",
    "package:all": "node scripts/package.mjs --all-platforms --publish never",
    "lint": "eslint .",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "@fontsource/geist-mono": "^5.2.7",
    "@goosar/core": "workspace:*",
    "@goosar/ui": "workspace:*",
    "@goosar/views": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "fix-path": "^5.0.0",
    "lucide-react": "catalog:",
    "motion": "^12.38.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "^7.6.0",
    "shadcn": "^4.1.0",
    "sonner": "^2.0.7",
    "tw-animate-css": "^1.4.0",
    "yaml": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@goosar/eslint-config": "workspace:*",
    "@goosar/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "catalog:",
    "tailwindcss": "^4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
