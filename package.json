{
  "name": "goosar",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "turbo dev --filter=@goosar/web",
    "dev:docs": "turbo dev --filter=@goosar/docs",
    "dev:desktop": "turbo dev --filter=@goosar/desktop",
    "dev:desktop:staging": "turbo dev:staging --filter=@goosar/desktop",
    "dev:mobile": "pnpm -C apps/mobile dev",
    "dev:mobile:staging": "pnpm -C apps/mobile dev:staging",
    "dev:mobile:prod": "pnpm -C apps/mobile dev:prod",
    "ios:mobile": "pnpm -C apps/mobile ios",
    "ios:mobile:staging": "pnpm -C apps/mobile ios:staging",
    "ios:mobile:prod": "pnpm -C apps/mobile ios:prod",
    "ios:mobile:device": "pnpm -C apps/mobile ios:device",
    "ios:mobile:device:staging": "pnpm -C apps/mobile ios:device:staging",
    "ios:mobile:device:staging:release": "pnpm -C apps/mobile ios:device:staging:release",
    "ios:mobile:device:prod": "pnpm -C apps/mobile ios:device:prod",
    "ios:mobile:device:prod:release": "pnpm -C apps/mobile ios:device:prod:release",
    "build": "turbo build --filter=!@goosar/mobile",
    "typecheck": "turbo typecheck --filter=!@goosar/mobile",
    "test": "turbo test --filter=!@goosar/mobile",
    "lint": "turbo lint --filter=!@goosar/mobile",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "clean": "turbo clean && rm -rf node_modules",
    "ui:add": "cd packages/ui && npx shadcn@latest add",
    "generate:reserved-slugs": "node scripts/generate-reserved-slugs.mjs"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ],
    "overrides": {
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@xmldom/xmldom": "^0.9.12",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@2": "^2.1.4",
      "brace-expansion@5": "^5.0.9",
      "browserslist": "^4.28.7",
      "builder-util-runtime": "^9.7.0",
      "fast-uri": "^3.1.6",
      "hono": "^4.12.25",
      "ip-address": "^10.3.1",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "linkify-it": "^5.0.2",
      "nanoid@3": "^3.3.18",
      "path-to-regexp@8": "^8.4.0",
      "picomatch@2": "^2.3.2",
      "picomatch@4": "^4.0.4",
      "plist": "^3.1.1",
      "postcss": "8.5.18",
      "protobufjs": "^7.6.1",
      "react-router": "^7.18.2",
      "sharp": "^0.35.0",
      "shell-quote": "^1.9.0",
      "tar": "^7.5.21",
      "uuid": "11.1.1",
      "vite": "^8.0.16",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "pg": "^8.20.0",
    "prettier": "^3.9.7",
    "turbo": "^2.5.4",
    "typescript": "catalog:",
    "vite": "^8.0.16"
  }
}
