# Database
POSTGRES_DB=goosar
POSTGRES_USER=goosar
POSTGRES_PASSWORD=goosar
POSTGRES_PORT=5433
DATABASE_URL=postgres://goosar:goosar@localhost:5433/goosar?sslmode=disable
# TLS on the hop to PostgreSQL (#386). Applies to the Docker Compose stack,
# which builds DATABASE_URL from the POSTGRES_* values above.
#
# Default: disable. The bundled Postgres container ships without certificates
# and shares a private compose network with the backend, so requiring TLS by
# default would break every existing stand. Change it deliberately:
#   * external managed database  -> POSTGRES_SSLMODE=require (encrypted), or
#     verify-full with a CA (see SELF_HOSTING.md «TLS для базы данных»);
#   * bundled Postgres over TLS  -> run scripts/selfhost-pg-tls.sh and start
#     with -f docker-compose.selfhost.tls.yml, which defaults to verify-full.
POSTGRES_SSLMODE=disable
# Optional pgxpool tuning. Defaults are 25 / 5 per pod and are usually fine.
# You can also set pool_max_conns / pool_min_conns as query params on
# DATABASE_URL; env vars below take precedence over URL params.
# DATABASE_MAX_CONNS=25
# DATABASE_MIN_CONNS=5

# Server
# APP_ENV gates production safety checks. Docker self-host pins APP_ENV to
# "production" by default. Local dev can leave it unset.
# See SELF_HOSTING.md, «Конфигурация», for the full login setup.
APP_ENV=
# Optional local/testing shortcut. Empty by default, so there is no fixed
# verification code. Without RESEND_API_KEY / SMTP_HOST, generated codes print
# to the container log — and only on a non-production APP_ENV: with APP_ENV=production and
# no mail transport the server refuses sign-in (503 email_not_configured).
# If you need deterministic local automation, set a 6-digit value such as
# 888888 and keep APP_ENV non-production. This is ignored when APP_ENV=production.
GOOSAR_DEV_VERIFICATION_CODE=
# Logging (#434). Application logs go to stderr; the audit journal (#389) owns
# stdout. LOG_FORMAT: json (one object per line, RFC3339 timestamp — what a
# SIEM wants) or text (human-readable, the default when running the binary
# directly). The Docker self-host stack defaults to json; set text here to
# override it. LOG_LEVEL: debug|info|warn|error; empty = the built-in default,
# which is info on APP_ENV=production and debug elsewhere.
LOG_FORMAT=
LOG_LEVEL=
# Docker log-driver caps for every service in docker-compose.selfhost.yml.
# Defaults keep ~250 MB of recent history per container.
LOG_MAX_SIZE=
LOG_MAX_FILE=
PORT=8081
# Docker Compose consumes flat port values. Set BACKEND_PORT directly to
# override the backend host port.
BACKEND_PORT=8081
# Optional aliases for local/self-host backend port helpers outside compose.
# API_PORT=8081
# SERVER_PORT=8081
FRONTEND_PORT=3001
# Public deployments: set ONE public host (bare hostname or full origin) and
# scripts/selfhost-env.sh (run by `make selfhost`) derives FRONTEND_ORIGIN,
# GOOSAR_APP_URL, GOOSAR_PUBLIC_URL, and CORS_ALLOWED_ORIGINS from it —
# unless you set any of them explicitly (explicit values always win).
# GOOSAR_TRUSTED_PROXIES stays manual: it is the reverse proxy's CIDR list.
# Example: PUBLIC_HOST=goosar.example.com
PUBLIC_HOST=
# Derived by docker-compose.selfhost.yml / local scripts from FRONTEND_PORT.
# Set explicitly only when serving frontend on a different origin/domain.
FRONTEND_ORIGIN=http://localhost:${FRONTEND_PORT}
# Prometheus metrics are disabled by default. When enabled, bind to loopback
# unless you protect the listener with private networking, allowlists, or
# proxy auth. Do not expose this endpoint through the public app/API ingress.
# HTTP request metrics start accumulating only when this listener is enabled.
# METRICS_ADDR=127.0.0.1:9090
# docker-compose.selfhost.monitoring.yml (#396) pins METRICS_ADDR=0.0.0.0:9090
# on the backend container and keeps the port on the compose network only. The
# overlay ignores whatever is set here on purpose: a loopback bind inside the
# container would leave Prometheus scraping nothing.
# REQUIRED for any real deployment: token signing secret. Generate with
# `openssl rand -hex 32` (make selfhost fills it in automatically). The
# backend refuses to start when APP_ENV=production and JWT_SECRET is empty
# or still a known placeholder; docker-compose.selfhost.yml also requires it.
# Local dev may leave it empty — the server falls back to an INSECURE
# development secret and logs a loud warning.
JWT_SECRET=

# JWT_SECRET rotation grace window (#388): comma-separated RETIRED signing
# secrets that are still accepted for VERIFICATION. New tokens are always
# signed with JWT_SECRET. Set this to the old secret when you change
# JWT_SECRET, wait one auth-token TTL (30 days by default, or however long you
# are willing to leave the old secret alive), then empty it and restart.
#
# There is no automatic expiry: the retired secret verifies until you empty
# this variable (the backend warns on every start while it is set), and in
# APP_ENV=production a known placeholder value here refuses startup, exactly as
# it does in JWT_SECRET.
#
# This is NOT the revocation lever. To sign someone out immediately — or
# everyone — bump their session epoch (deactivate / revoke sessions, #390);
# rotating JWT_SECRET with no grace window signs out every user at once,
# which is the right answer only when the SECRET itself leaked.
JWT_SECRET_PREVIOUS=
# Derived by Makefile / local scripts from the backend port.
# Set explicitly only when the daemon reaches the API through a different URL.
# GOOSAR_SERVER_URL=ws://localhost:8081/ws
# How long an offline runtime may reconnect before its in-flight tasks fail
# (runtime_offline) and its deferred reconnect retries expire
# (runtime_reconnect_timeout). Accepts a positive Go duration. Default 3h;
# values below 150s are clamped to the runtime heartbeat freshness window.
GOOSAR_RUNTIME_RECONNECT_GRACE=3h
# Derived by docker-compose.selfhost.yml / local scripts from FRONTEND_ORIGIN.
# Set explicitly only when the app's public URL differs from local frontend.
GOOSAR_APP_URL=${FRONTEND_ORIGIN}
# Public URL the API is reachable at from the open internet (no trailing
# slash). Used to mint absolute webhook URLs for autopilot webhook
# triggers and to show correct daemon setup commands in the web UI. Leave
# unset behind a same-origin reverse proxy or for plain localhost dev —
# the frontend will compose the URL from window.origin + webhook_path in
# that case. Headers are intentionally not used to derive this value, to
# avoid Host / X-Forwarded-Host spoofing when a self-hosted reverse proxy
# is not hardened.
GOOSAR_PUBLIC_URL=
# Optional delay after SIGTERM/SIGINT before the existing graceful shutdown
# begins. Accepts a non-negative Go duration such as 300s or 5m. Empty or 0
# preserves the default behavior and starts shutdown immediately. The platform
# termination grace period must cover this hold plus the later shutdown work.
GOOSAR_SHUTDOWN_HOLD_DURATION=
# Comma-separated CIDR list of reverse proxies whose X-Forwarded-For /
# X-Real-IP headers the per-IP webhook rate limiter is allowed to trust.
# Empty (the default) means "trust no headers" — the limiter uses
# r.RemoteAddr only, which is the safe shape when the backend is
# exposed directly. Set this when running behind nginx/Caddy/Cloudflare:
# e.g. "127.0.0.1/32" for a same-host reverse proxy, or the CDN's
# announced ranges for cloud deployments.
GOOSAR_TRUSTED_PROXIES=
# Basic LLM API layer. Backs server-internal LLM helpers such as
# chat title generation (the generic OpenAI-compatible passthrough endpoints
# were removed — LLM access is internal-only). When both API key
# and base URL are empty the layer is disabled and callers fall back silently.
#   - API key for the upstream (OpenAI or any OpenAI-compatible gateway).
#     Setting a key REQUIRES an explicit GOOSAR_LLM_BASE_URL below — the
#     layer refuses to run (feature disabled, loud error) rather than
#     silently sending chat text to api.openai.com.
GOOSAR_LLM_API_KEY=
#   - Base URL of the upstream. REQUIRED whenever GOOSAR_LLM_API_KEY is
#     set; there is no implicit default host. Point it at OpenAI
#     (https://api.openai.com/v1), a gateway, or a self-hosted
#     OpenAI-compatible model server.
GOOSAR_LLM_BASE_URL=
#   - Default model used when a request omits `model`. When unset, falls
#     back to a small built-in default (gpt-4o-mini).
GOOSAR_LLM_DEFAULT_MODEL=
GOOSAR_DAEMON_CONFIG=
GOOSAR_WORKSPACE_ID=
GOOSAR_DAEMON_ID=
GOOSAR_DAEMON_DEVICE_NAME=
GOOSAR_DAEMON_POLL_INTERVAL=3s
GOOSAR_DAEMON_HEARTBEAT_INTERVAL=15s
# Per-runtime executable and default model. Every supported runtime takes the
# same three overrides, named after its runtime code:
# GOOSAR_RUNTIME_<LETTER>_PATH / _MODEL / _ARGS. Unset means "find the
# runtime's CLI on PATH and follow its own configured model".
GOOSAR_RUNTIME_E_PATH=codex
GOOSAR_RUNTIME_E_MODEL=

# Feature flags
# Optional path to a YAML file declaring feature flag rules. When unset,
# every flag falls through to the caller's default, which lets the server
# boot before any flag config is authored. When set, the file is read once
# at startup and a parse / IO error fails fast — same loud-failure shape as
# DATABASE_URL or JWT_SECRET misconfig. See docs/feature-flags.md for the
# full schema; the minimum example is:
#
#   billing_new_invoice_email:
#     default: true
#   checkout_algo:
#     default: false
#     variant: experiment-v2
#     percent: { percent: 25, by: user_id }
#
# Individual flags can also be overridden without touching the YAML by
# setting FF_<FLAG_KEY> env vars (FF_BILLING_NEW_INVOICE_EMAIL=false, 25%,
# or any variant string). The env override beats the YAML, which is the
# Ops kill-switch path — flip a flag without redeploying by restarting the
# process with the env var set.
GOOSAR_FEATURE_FLAGS_FILE=

# Self-host image channel
# Left empty here on purpose: `make selfhost` pins this to the newest release
# tag found in the clone when it first creates .env, so a fresh self-host
# never silently runs a stale version (issue #280). Empty means the compose
# default `latest` applies. Pin to an exact release like v0.8.1 to stay on a
# specific version. If the selected tag has not been published to GHCR yet,
# use make selfhost-build / the build override instead.
GOOSAR_IMAGE_TAG=
GOOSAR_BACKEND_IMAGE=ghcr.io/adanman/goosar-backend
GOOSAR_WEB_IMAGE=ghcr.io/adanman/goosar-web

# Optional supply-chain digest pinning (issue #68). A release TAG is still
# mutable at the registry; pin the exact image by setting these to the
# "@sha256:<digest>" the tag resolved to (leading @ included). Left empty
# (default) the ref stays repo:tag — behavior is unchanged. Get the digest
# after a release with:
#   docker buildx imagetools inspect ghcr.io/adanman/goosar-backend:<tag>
# postgres (pgvector) is already digest-pinned directly in
# docker-compose.selfhost.yml. For fully air-gapped delivery, carry the images
# across with offline/save-release-images.sh + offline/load-release-images.sh.
GOOSAR_BACKEND_DIGEST=
GOOSAR_WEB_DIGEST=

# Email
# Two delivery options - only one needs to be configured. With NEITHER, a
# deployment on APP_ENV=production (or GOOSAR_DELIVERY_PROFILE=perimeter)
# refuses sign-in with 503 email_not_configured instead of printing a code to
# a log the user cannot read.
#
# Option A: Resend (SaaS, recommended for cloud deployments)
#   Set RESEND_API_KEY to a key from resend.com and verify your sending domain there.
#   For local/dev use, leave RESEND_API_KEY empty - codes print to stdout. To
#   accept a fixed local code, also set GOOSAR_DEV_VERIFICATION_CODE above
#   (ignored when APP_ENV=production).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@goosar.ru
#
# Option B: SMTP relay (for self-hosted / on-premise deployments)
#   Takes priority over Resend when SMTP_HOST is set.
#   Supports unauthenticated relay (leave SMTP_USERNAME empty) and authenticated SMTP.
#   SMTP_FROM_EMAIL is the envelope/header sender for SMTP. If unset, SMTP
#     falls back to RESEND_FROM_EMAIL; with neither set the server refuses to
#     start rather than failing on the first send.
#   Set SMTP_TLS_INSECURE=true only for private CA or self-signed certificates.
#   SMTP_TLS controls the TLS mode:
#     - unset / "starttls" (default): plaintext connect, upgrade via STARTTLS.
#     - "implicit" (aliases: "smtps", "ssl"): TLS handshake on connect (SMTPS).
#       Required by providers that only offer port 465 and do not advertise
#       STARTTLS (e.g. Aliyun enterprise mail). Auto-enabled when SMTP_PORT=465
#       and SMTP_TLS is unset.
#   SMTP_EHLO_NAME is the EHLO/HELO name announced to the relay. Defaults to the
#     machine hostname; set a real FQDN when a strict relay (e.g. Google Workspace
#     smtp-relay.gmail.com) rejects the default and the connection drops as an EOF.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS_INSECURE=false
SMTP_TLS=
SMTP_EHLO_NAME=

# S3 / CloudFront
# S3_BUCKET — bucket NAME only (e.g. "my-bucket"). Do NOT include the
# ".s3.<region>.amazonaws.com" suffix; the server builds the public URL
# from S3_BUCKET + S3_REGION. S3_REGION must match the bucket's real region.
S3_BUCKET=
# S3_REGION — the bucket's AWS region. When S3_BUCKET is set, the server
# refuses to start unless the upload destination is explicit: set S3_REGION
# for real AWS S3, or AWS_ENDPOINT_URL below for an S3-compatible endpoint.
# There is no default region anymore — uploads never silently target
# amazonaws.com us-west-2.
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL — optional S3-compatible endpoint (MinIO, RustFS, R2, etc.).
# For internal Docker/VPC hosts such as http://rustfs:9000, leave
# ATTACHMENT_DOWNLOAD_MODE=auto or set proxy explicitly so browsers/CLI do
# not need direct access to the object store.
AWS_ENDPOINT_URL=
# S3_USE_PATH_STYLE — optional S3 addressing mode. Empty preserves the default:
# true when AWS_ENDPOINT_URL is set for MinIO/LocalStack-style endpoints, false
# for AWS S3. Set to false for providers that require virtual-hosted-style URLs.
S3_USE_PATH_STYLE=
ATTACHMENT_DOWNLOAD_MODE=auto
ATTACHMENT_DOWNLOAD_URL_TTL=30m
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_SECRET=goosar/cloudfront-signing-key
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_DOMAIN=
# COOKIE_DOMAIN — optional Domain attribute on session + CloudFront cookies.
# Leave empty for single-host deployments (localhost, LAN IP, or a single
# hostname) — session cookies become host-only, which is what the browser
# wants. Only set it when the frontend and backend sit on different
# subdomains of one registered domain (e.g. ".example.com"). Do NOT set it
# to an IP address: RFC 6265 forbids IP literals in the cookie Domain
# attribute and browsers silently drop such cookies.
COOKIE_DOMAIN=

# AUTH_TOKEN_TTL — auth token lifetime. Accepts Go duration strings (e.g.
# "8760h", "720h30m") or plain integer seconds.
# Default: 2592000 (30 days). Self-hosted deployments on trusted networks can
# set a longer value to reduce re-authentication frequency.
# Note: longer TTL = longer exposure window if a cookie is leaked.
# AUTH_TOKEN_TTL=2592000

# Local file storage (fallback when S3_BUCKET is not set)
LOCAL_UPLOAD_DIR=./data/uploads
# Derived by Makefile / local scripts from the backend port.
# Set explicitly only when uploads are served through a different public URL.
# LOCAL_UPLOAD_BASE_URL=http://localhost:8081

# Provisioning package registry (issue #172/#183) — the in-perimeter store the
# server serves skills / MCP servers / runtimes from. Disabled by default:
# with GOOSAR_PROVISIONING_STORE unset (or unrecognized) the provisioning
# endpoints answer 503 "provisioning is not configured" and everything else
# works as before.
#   local  reuse the attachments storage backend (S3_* or LOCAL_UPLOAD_DIR)
#          as a content-addressed package store; see SELF_HOSTING.md
#          «Каталог пакетов (provisioning store)» for the on-disk layout and how to publish packages into it.
#   oci    read packages from an OCI/ORAS registry via the
#          GOOSAR_PROVISIONING_OCI_* settings below.
GOOSAR_PROVISIONING_STORE=

# Key prefix inside the storage backend for GOOSAR_PROVISIONING_STORE=local.
# Default "provisioning" — the store then reads
# $LOCAL_UPLOAD_DIR/$GOOSAR_PROVISIONING_LOCAL_PREFIX/catalog.json etc.
# GOOSAR_PROVISIONING_LOCAL_PREFIX=provisioning
# Registry settings for GOOSAR_PROVISIONING_STORE=oci. URL is required
# (e.g. https://registry.example.com); without it provisioning stays
# disabled. REPOSITORY is the optional repository namespace packages are
# published under. USERNAME/PASSWORD are optional registry credentials for
# private registries — leave empty for anonymous pulls.
# GOOSAR_PROVISIONING_OCI_URL=
# GOOSAR_PROVISIONING_OCI_REPOSITORY=
# GOOSAR_PROVISIONING_OCI_USERNAME=
# GOOSAR_PROVISIONING_OCI_PASSWORD=
# Registries without /v2/_catalog (GHCR): explicit list of packages to mirror
# on first boot, comma-separated name@version. Empty = ask the registry catalog.
# GOOSAR_PROVISIONING_OCI_PACKAGES=
# Budget for the first-boot kit mirror; startup continues without the kit on
# timeout (registry proxy mode). Default 3m.
# GOOSAR_PROVISIONING_SYNC_TIMEOUT=3m

# Security
# GOOSAR_EXTERNAL_IMAGES — policy for markdown-authored external images
# (issue #64). An external image URL in a comment or agent answer makes every
# viewing client fetch an arbitrary third-party server, which leaks the
# viewer's address — a content-controlled exfiltration channel.
#   allow      (default) render external images as before; CSP img-src stays
#              'self' https: data:
#   block      replace external images with a placeholder; CSP img-src becomes
#              'self' data: plus this deployment's own storage hosts
#              (CLOUDFRONT_DOMAIN / LOCAL_UPLOAD_BASE_URL)
#   allowlist  like block, plus the hosts listed in GOOSAR_IMAGE_HOSTS
# Any other non-empty value is treated as "block" (fail closed on typos).
# Attachments always keep rendering in every mode.
#
# Enforcement is split across the two services, both reading these vars:
#   - the Go backend stamps the CSP on API / /uploads / attachment-preview
#     responses (server/internal/middleware/csp.go);
#   - the Next.js frontend stamps the img-src CSP on the app documents that
#     render chat and comments (apps/web/lib/image-policy-csp.ts) — in
#     docker-compose deployments set the vars on BOTH services (see
#     docker-compose.selfhost.yml).
# Read at process startup — restart both services after changing.
# GOOSAR_EXTERNAL_IMAGES=allow
# GOOSAR_IMAGE_HOSTS — comma-separated image hosts for allowlist mode.
# Exact hostnames, optionally with scheme:// and :port; no wildcards. Also
# the escape hatch for non-markdown external images the app renders (OAuth
# avatar hosts, logo CDNs) on deployments that restrict the mode.
# Example: GOOSAR_IMAGE_HOSTS=cdn.example.com,https://media.example.com:8443
# GOOSAR_IMAGE_HOSTS=

# Comma-separated list of allowed origins for CORS and WebSocket connections.
# Defaults to localhost dev origins when unset.
# Example: CORS_ALLOWED_ORIGINS=https://goosar.ru,https://staging.goosar.ru
CORS_ALLOWED_ORIGINS=

# ==================== Rate limiting (optional Redis) ====================
# Per-IP fixed-window rate limiter on the public auth endpoints
# (/auth/send-code, /auth/verify-code) across several API nodes.
# When REDIS_URL is unset the limiter still runs, with a per-process
# in-memory counter — a single-node deployment is fully protected, and
# the backend logs `rate limiting enabled backend=memory` with the
# effective limits at startup (#387). The same REDIS_URL is reused by
# the realtime fan-out hub, the PAT cache, and the daemon-token cache.
# REDIS_URL=redis://localhost:6379/0
# Set to "true" to skip the CLIENT SETNAME handshake on every Redis
# connection. Required for managed Redis providers that block the CLIENT
# command (e.g. GCP Memorystore, AWS ElastiCache with restricted ACLs).
# Default is false (client naming enabled for connection observability).
# REDIS_DISABLE_CLIENT_NAME=true
# --- Rate limits (#387) -----------------------------------------------
# Every knob below is read at startup; changing one needs a restart, not
# a rebuild. Exceeding a budget returns HTTP 429 with a Retry-After
# header and a JSON body {"error":"too many requests","code":"rate_limited"}.
#
# Requests per IP per minute on the login surface.
# RATE_LIMIT_AUTH=5           # POST /auth/send-code
# RATE_LIMIT_AUTH_VERIFY=20   # POST /auth/verify-code, /auth/verify-link
# Guesses at the second factor (#391), counted per PENDING SIGN-IN TICKET
# rather than per account: six digits is guessable and a per-IP budget is no
# ceiling to somebody with many addresses, while a per-account counter would
# be a lockout anyone could trigger against anyone.
# RATE_LIMIT_MFA_VERIFY=10    # POST /api/auth/mfa/verify, per ticket
# Requests per e-mail address per minute on /auth/send-code and
# /auth/verify-code. Independent of the IP budget: it is what stops a
# pool of source addresses from spraying one mailbox or grinding one
# account's codes.
# RATE_LIMIT_AUTH_EMAIL=10
# Credential minting per user per HOUR: POST /api/cli-token and the
# /api/tokens group (create / renew / revoke personal access tokens).
# RATE_LIMIT_TOKEN=20
# Default ceiling for every other authenticated /api route, per user per
# minute (per IP when the request arrives unauthenticated). This is an
# abuse ceiling, not traffic shaping — keep it generous.
# RATE_LIMIT_API=600
# POST /api/contact-sales, per IP per hour.
# RATE_LIMIT_CONTACT_SALES=5
#
# Comma-separated CIDRs whose X-Forwarded-For the limiter is allowed to
# trust. Empty (default) = never trust XFF, only RemoteAddr.
# REQUIRED behind a reverse proxy — otherwise every real user shares
# the proxy IP and the whole deployment lands in one bucket, turning
# /auth/send-code into 5 req/min site-wide. Use e.g. "127.0.0.1/32,::1/128"
# for same-host Caddy/Nginx, or the CDN's published ranges for ALB/CF.
# Unset, the limiter falls back to GOOSAR_TRUSTED_PROXIES above, which
# is normally the right value — set this only to give the limiter a
# different list than the rest of the server.
# RATE_LIMIT_TRUSTED_PROXIES=

# Realtime metrics endpoint (/health/realtime) access control.
# When unset, the endpoint only serves direct loopback (127.0.0.1 / ::1)
# callers with no forwarding headers and returns 404 to everything else —
# safe for local dev. Any deployment behind a reverse proxy (Caddy / Nginx
# terminating TLS in front of localhost:8081) MUST set this token, since
# proxied requests look like loopback at the Go layer; with no token, those
# requests are refused with 404. Pass the token as
# `Authorization: Bearer <token>`.
# REALTIME_METRICS_TOKEN=

# GitHub App integration (Settings → GitHub "Connect GitHub")
# Both must be set for the Connect button to enable and for webhooks to be
# accepted; leave empty to disable the integration. See docs/github-integration.
# GITHUB_APP_SLUG is the tail of https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# Optional for webhook-only deployments, but required for PR-card CI /
# mergeability and Settings → Repositories → Choose from GitHub. These
# credentials let the server authenticate as the App, mint short-lived
# installation tokens, and enrich the installation row with the real account
# login immediately.
# GITHUB_APP_ID is the numeric "App ID" shown on the App's settings page.
# GITHUB_APP_PRIVATE_KEY is the full PEM block (including BEGIN/END lines)
# generated under "Private keys" on that same page; preserve newlines.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Self-hosted Git provider integration (Settings → Integrations): Forgejo, Gitea,
# and GitLab. This is a SELF-HOSTED-GOOSAR-ONLY feature (not offered on the
# managed cloud). Two settings gate it, and BOTH are required — connect,
# webhook, and rotate all check both:
#   1. GOOSAR_VCS_INTEGRATION_ENABLED=true turns the feature on for this
#      deployment. Left unset/false the section is hidden entirely (this is how
#      the managed cloud keeps it off). The self-host docker-compose sets it.
#   2. GOOSAR_VCS_SECRET_KEY — a base64-encoded 32-byte key that encrypts each
#      workspace's access token and webhook secret at rest. Generate one with:
#      openssl rand -base64 32
# Unlike GitHub there is no App: each workspace connects its own instance URL
# and access token in the UI, and registers the returned webhook URL/secret on
# its repo or org webhook settings.
GOOSAR_VCS_INTEGRATION_ENABLED=
GOOSAR_VCS_SECRET_KEY=

# Agent mcp_config at-rest encryption. mcp_config routinely embeds MCP server
# credentials (corporate PATs, gateway bearer tokens), so set this on every
# deployment: a base64-encoded 32-byte key, generate with: openssl rand -base64 32
# When set, mcp_config values are encrypted before they hit the database and a
# startup backfill encrypts existing plaintext rows. When unset, the server
# keeps working but stores mcp_config in PLAINTEXT and logs a startup warning —
# except on GOOSAR_DELIVERY_PROFILE=perimeter, where an unset key is a hard
# startup failure (#428): plaintext credentials in the database and in every
# backup are exactly what an on-prem deployment exists to prevent.
# `make selfhost` and `install.sh --with-server` generate this key for you.
# Do NOT remove the key after data has been encrypted — encrypted values are
# unreadable without it (they stay redacted in the UI and are skipped at
# dispatch until the key returns).
GOOSAR_MCP_SECRET_KEY=

# ROTATION (#388). Every GOOSAR_*_SECRET_KEY above accepts a companion
# <VAR>_PREVIOUS: a comma-separated list of RETIRED base64 keys that are still
# accepted for DECRYPTION while the current key does all encryption. Rows
# sealed under a retired key keep opening, so a rotation is not an outage.
#
#   1. move the live key into <VAR>_PREVIOUS, put a fresh
#      `openssl rand -base64 32` into <VAR>, restart the backend
#   2. docker compose exec backend ./goosar_admin rotate-secrets --mcp --dry-run
#   3. docker compose exec backend ./goosar_admin rotate-secrets --mcp
#   4. repeat the dry run until it reports stale=0 unreadable=0 (the command
#      exits non-zero while anything is unreadable), then EMPTY <VAR>_PREVIOUS
#      and restart — the retired key is dead only after that step
#
# rotate-secrets covers ONLY what GOOSAR_MCP_SECRET_KEY seals (agent
# same grace list but no re-encryption pass yet: keep their _PREVIOUS entry, or
# reconnect the integration, before emptying it.
#
# A malformed entry here is a hard error, not a warning: this variable exists
# only during a rotation, the one moment where a silently dropped key makes
# stored credentials unreadable forever. Full procedure: SELF_HOSTING.md →
# «Ротация ключей шифрования».
GOOSAR_MCP_SECRET_KEY_PREVIOUS=
GOOSAR_VCS_SECRET_KEY_PREVIOUS=
GOOSAR_SLACK_SECRET_KEY_PREVIOUS=

# Audit journal retention in days (#389). Applies to BOTH journals —
# admin_audit (deployment administration) and auth_audit (sign-ins, refused
# credentials, secret access). A daily job deletes rows older than this.
# Default when unset: 365. Set 0 to keep the journals FOREVER — the right
# value when an external archiver or a regulation owns deletion instead.
GOOSAR_AUDIT_RETENTION_DAYS=

# Deployment administrators (#213): comma-separated emails of EXISTING users
# that receive the deployment_admin role. This list only SEEDS the role while
# the deployment_admin table is empty (first deployment) — afterwards the
# database is authoritative, admins are managed through the deployment API,
# and a diverging env list is only logged, never enforced. Emails that have
# not signed up yet are resolved at their SIGN-UP, and retried on the next
# start, while the table stays empty. Composition changes afterwards, plus
# break-glass recovery (`goosar_admin grant <email>`), are documented in
# SELF_HOSTING.md → «Администраторы развёртывания».
GOOSAR_DEPLOYMENT_ADMIN_EMAILS=

# Deployment defaults (#493): адреса заказчика, которые web-клиент читает из /api/config,
# а desktop — из запечённого deployment.json. Пусто = нейтральные гайды, пресет LLM контура не предлагается.
GOOSAR_DEPLOYMENT_JIRA_URL=
GOOSAR_DEPLOYMENT_CONFLUENCE_URL=
GOOSAR_DEPLOYMENT_EWS_URL=
GOOSAR_DEPLOYMENT_MAIL_DOMAIN=
# T-12 (#640, ADR-0019): read in every profile, not just perimeter. Feeds
# goosar_admin mcp-library seed (T-13) as deployment_mcp_server URLs.
GOOSAR_DEPLOYMENT_BITRIX24_URL=
GOOSAR_DEPLOYMENT_MCP_GATEWAY_URL=
GOOSAR_DEPLOYMENT_LLM_API_BASE=
GOOSAR_DEPLOYMENT_LLM_MODEL=

# Role workspaces (#484): auto | off. Default auto — on every start the
# deployment creates one workspace per enabled workspace_template row (HR,
# finance, legal, sales, procurement, marketing), owned by the FIRST
# deployment administrator, with
# the template's package pins, sealed MCP presets and Helper defaults
# applied. Idempotent: a workspace that already exists is left alone.
# The run needs GOOSAR_MCP_SECRET_KEY (template MCP presets are sealed at
# rest) and at least one deployment administrator; without an administrator
# it creates nothing and repeats on the next start. Set off to manage roles
# by hand; `goosar_admin provision-roles` runs the same procedure on
# demand. Any other value refuses startup.
GOOSAR_ROLE_WORKSPACES=

# Lark / Feishu bot integration (Settings → Integrations "Bind to Lark")
# that encrypts each Bot's app secret at rest. Leave empty to disable.
# Generate one with: openssl rand -base64 32
# Mainland 飞书 and international Lark are auto-detected per installation
# (at QR scan) and served side by side — LEAVE THESE EMPTY for normal use.
# They are optional deployment-wide overrides that force EVERY installation
# onto one host (a proxy, a mock for tests, or a single-cloud staging
# setup); HTTP drives outbound Open Platform API calls, CALLBACK the inbound
# long-conn bootstrap. NOTE: if you previously ran international Lark by
# setting these to https://open.larksuite.com, the server relabels your
# existing installs to region=lark on first boot after upgrade, so you can
# clear these afterwards. See docs/lark-bot-integration.
# Optional fixed HTTP CONNECT proxy URL for Lark/Feishu WebSocket long-conn
# handshakes. Leave empty to use standard HTTP_PROXY / HTTPS_PROXY / NO_PROXY
# environment handling.

# Frontend
# Leave empty — auto-derived from page origin in browser, set by Makefile for local dev.
# NEXT_PUBLIC_API_URL also feeds the Next.js SSR proxy when explicitly set.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Landing / download page (web frontend)
# The landing never calls api.github.com from visitors' browsers. To show a
# star count on the header's GitHub button, set a static value here; leave
# empty to hide the badge. Read per request — a restart applies it.
GOOSAR_GITHUB_STARS=
# /download lists desktop installers from the latest GitHub release. The
# server-side fetch is anonymous (no GITHUB_TOKEN is ever attached) and
# cached for 5 minutes. Set to "off" (also accepts "false"/"0") to disable
# the outbound call entirely — the self-served CLI installer (/install.sh +
# /cli) and GOOSAR_MAC_DMG_URL below keep working.
GOOSAR_DOWNLOAD_GITHUB_RELEASES=
# Current macOS .dmg download URL for /download. The mac build is signed and
# notarized outside CI, so GitHub releases usually carry no mac asset; point
# this at the uploaded file. Read per request — no image rebuild needed.
GOOSAR_MAC_DMG_URL=
# Same for the other self-served desktop builds (all optional; a set URL is
# shown on /download only when the GitHub release has no such asset).
GOOSAR_MAC_X64_DMG_URL=
GOOSAR_WIN_X64_EXE_URL=
GOOSAR_LINUX_X64_APPIMAGE_URL=
GOOSAR_LINUX_ARM64_APPIMAGE_URL=

# Remote API (optional) — set to proxy local frontend to a remote backend
# Leave empty to use local backend (localhost:8081)
# REMOTE_API_URL=https://goosar.ru

# ==================== Self-hosting: Control Signups (fixes #930) ====================
# Set to "false" to completely disable new user signups (recommended for private instances)
ALLOW_SIGNUP=true
# The web UI reads ALLOW_SIGNUP from /api/config at runtime, so toggling this
# only requires restarting the backend / compose stack — not rebuilding web.
# It is not hot-reloaded.

# Optional: Only allow emails from these domains (comma-separated)
ALLOWED_EMAIL_DOMAINS=

# Optional: Only allow these exact email addresses (comma-separated)
ALLOWED_EMAILS=

# ==================== Corporate sign-in: OIDC / LDAP (#394) ====================
# Which sign-in methods this deployment offers. Comma-separated, any of
# `email`, `oidc`, `ldap`. Empty or absent means `email` — the only door this
# product had before #394, so an upgrade changes nothing until you say so.
#
# This governs the SERVER, not just the UI: a method not listed here is closed
# at the endpoint whether or not it is configured below. A method listed but
# not fully configured is simply not offered, and the backend says so in its
# startup log. Read per request, so flipping a method on needs no rebuild.
#
# Design and rationale: docs/auth/corporate-auth.md
GOOSAR_AUTH_METHODS=

# -------- Second factor (TOTP), issue #391 ------------------------------------
# The name an authenticator app shows for this stand. Empty = "Goosar".
# Set it when a team runs more than one deployment: the phone lists entries by
# issuer, and two identically named ones are a support ticket waiting to happen.
#
# The second factor itself needs no flag — a person turns it on for their own
# account in Settings → Security, and GOOSAR_MCP_SECRET_KEY must be set,
# because the shared secret is sealed with it. Deployment-wide policy (idle
# timeout, absolute lifetime, session cap, require-MFA) lives in the deployment
# policy document, not in the environment: see SELF_HOSTING.md →
# «MFA и сессии».
GOOSAR_TOTP_ISSUER=

# -------- OIDC (primary): Keycloak, ADFS, Yandex ID / Cloud Organization, --------
# -------- Okta, Authentik, or any provider serving a discovery document  --------
# The issuer URL, WITHOUT the /.well-known/openid-configuration suffix.
GOOSAR_OIDC_ISSUER=
GOOSAR_OIDC_CLIENT_ID=
# Empty = a public client. PKCE (S256) is applied either way and is not
# optional; the secret protects the token endpoint, the verifier protects the
# redirect, and they defend different things.
GOOSAR_OIDC_CLIENT_SECRET=
# Must match the redirect URI registered at the provider, exactly.
#   https://goosar.example.test/api/auth/oidc/callback
GOOSAR_OIDC_REDIRECT_URL=
# Comma-separated. Defaults to openid,profile,email. `openid` is added even if
# you leave it out — without it the provider need not return an id_token at all.
GOOSAR_OIDC_SCOPES=
# Admin mapping. BOTH must be set for the mapping to exist at all. A match
# files a PENDING deployment_admin request (#426) that an operator confirms on
# the server with `goosar_admin confirm <id>` — it never grants the role.
# A directory group is not a second channel: the same administrator runs the
# stand and the directory.
GOOSAR_OIDC_ADMIN_CLAIM=
GOOSAR_OIDC_ADMIN_VALUE=
# What the sign-in button says, in your own words ("Вход через Keycloak").
# Empty = the client's own localized label.
GOOSAR_OIDC_DISPLAY_NAME=

# -------- LDAP / Active Directory (fallback for deployments without an IdP) --------
# ldaps://host:636, or ldap://host:389 together with START_TLS=true.
# PLAIN ldap:// WITHOUT StartTLS IS REFUSED: a simple bind puts the person's
# domain password on the wire in the clear (RFC 4513 §3). The method is not
# offered at all rather than silently degrading.
GOOSAR_LDAP_URL=
GOOSAR_LDAP_START_TLS=false
# Service account used to SEARCH for the person before their own bind. Leave
# both empty only if the directory permits anonymous search.
GOOSAR_LDAP_BIND_DN=
GOOSAR_LDAP_BIND_PASSWORD=
GOOSAR_LDAP_BASE_DN=
# %s is replaced with the RFC 4515-escaped input, once per occurrence. The
# default covers both ways an AD account spells its login.
GOOSAR_LDAP_USER_FILTER=
GOOSAR_LDAP_EMAIL_ATTR=mail
GOOSAR_LDAP_NAME_ATTR=displayName
# DN of the group mapped to deployment_admin. Same pending-request rule as the
# OIDC claim above: it files, it never grants.
GOOSAR_LDAP_ADMIN_GROUP=
GOOSAR_LDAP_DISPLAY_NAME=

# Set to "true" to disable workspace creation for every caller on this
# instance (#3433). Operators usually leave this unset, bootstrap the
# shared workspace, then flip this to "true" and restart so subsequent
# users join only via invitations and the entire deployment is visible to
# the platform admin. The web UI reads this from /api/config at runtime,
# so toggling requires a backend restart but not a frontend rebuild.
DISABLE_WORKSPACE_CREATION=

# ==================== Delivery Profile ====================
# How this deployment is delivered and operated (#63):
# Left empty the server reads `cloud`. Note that the self-host bootstrap
# (scripts/selfhost-env.sh, used by `make selfhost` and
# `install.sh --with-server`) writes `perimeter` into a freshly created .env:
# self-hosting IS the on-prem product. See SELF_HOSTING.md →
# «Профиль доставки и исходящий трафик» for the destination/switch table.
#   cloud     (default) — current public behavior, unchanged.
#   perimeter — operator-managed closed-network deployment: every
#               self-update channel (daemon auto-update, `goosar update`,
#               desktop updater / CLI download) is forced off; updates are
#               delivered by the operator. Advertised to clients via
#               /api/config as delivery_profile.
# Any other value is a hard startup error (a typo must not silently run a
# closed-network deployment with cloud defaults).
# On daemon/runtime machines, exporting GOOSAR_DELIVERY_PROFILE=perimeter
# locally pins BOTH the daemon auto-update poller and `goosar update` off,
# even offline and even over GOOSAR_DAEMON_AUTO_UPDATE=true — bake it into
# perimeter machine images.
GOOSAR_DELIVERY_PROFILE=

# ==================== Deployment profile (ADR-0015) ====================
# What KIND of stand this is — a different question from the delivery profile
# above (how it is delivered and updated):
#   perimeter (default, also when empty) — a customer's closed network:
#             registration closed, nothing preseeded the customer did not ask
#             for. Set ALLOWED_EMAIL_DOMAINS (or ALLOWED_EMAILS) before the
#             first start, or nobody can sign in — including you.
#   demo      — a preview stand: demo integrations.
#   dev       — a development stand.
#   local     — a developer machine.
# `install.sh --profile <name>` / `install.ps1 -Profile <name>` write this
# variable together with the rest of the profile's variable set; the full
# table is docs/release-0.10.1/21-adr/ADR-0015-deployment-profiles.md and
# SELF_HOSTING.md → «Профили развёртывания». Exported in the environment it is
# honored by both installers when the flag is absent; the flag wins. Values are
# trimmed and lowercased. Any other value is a hard startup error. Reported to the operator by GET /api/status and `goosar
# support-bundle`.
GOOSAR_DEPLOYMENT_PROFILE=

# Daemon-side opt-out that works in any profile: set to "off" (also
# false/0/no) on a runtime machine to force the daemon's auto-update
# poller off regardless of which server it talks to.
# GOOSAR_DAEMON_AUTO_UPDATE=off

# ==================== External Skill Sources ====================
# Which external skill sources the server may fetch from on behalf of users
# (#66): ClawHub search + import, skills.sh import, github.com import.
# Comma-separated list of sources to enable — clawhub, github, skillssh —
# or "none" to disable every external source. Unset selects the delivery
# profile default:
#   cloud     — every source enabled (current behavior, unchanged).
#   perimeter — every source DISABLED: no user search queries leave the
#               deployment, no third-party skill content is fetched, and
#               GITHUB_TOKEN is never attached to skill-fetch requests.
# Built-in agent templates keep working either way: their skills ship
# vendored inside the server binary. A disabled source answers with a clear
# 403 naming this variable, and /api/config advertises the enabled list so
# the UI hides the matching import affordances. Any unknown source name is
# a hard startup error.
# Example: GOOSAR_SKILL_SOURCES=github,skillssh
GOOSAR_SKILL_SOURCES=

# ==================== Perimeter Allowlist Policies ====================
# Server-side allowlists for what agents can reach (#65/#69). All three
# follow the delivery-profile rule: unset on the cloud profile keeps the
# current behavior byte-for-byte; unset on the perimeter profile fails
# CLOSED to a built-in corporate baseline (the MCP preset commands/hosts
# from onboarding and the hermes provider), which a set value EXTENDS on
# perimeter (and replaces on cloud). See SELF_HOSTING.md, «Конфигурация».
#
# Comma-separated hostnames MCP entries in agent mcp_config may reference:
# checked against remote entries' url AND every http(s):// URL embedded in
# args elements or env values (loopback/127.0.0.1 proxy plumbing exempt).
GOOSAR_MCP_ALLOWED_HOSTS=
# Comma-separated executables stdio MCP entries may launch, matched by
# basename (same semantics as hermes's allow_daemon_mcp_commands gate);
# config entries must use bare names — path-qualified commands are
# rejected. WARNING: never allowlist interpreters or generic runners
# (npx, python, bash, docker, ...) — that grants arbitrary execution.
GOOSAR_MCP_ALLOWED_COMMANDS=
# Comma-separated runtime codes whose runtimes may back agents and
# take work (e.g. "runtime-b,runtime-c"). Unknown codes are a hard startup
# error. The effective list is advertised via /api/config as
# allowed_providers (omitted when unrestricted) so UIs hide the rest.
GOOSAR_ALLOWED_PROVIDERS=

# ==================== Analytics (PostHog) ====================
# Product analytics events feed the acquisition → activation → expansion funnel.
# Leave POSTHOG_API_KEY empty for local dev / self-hosted instances; the server
# will run a no-op analytics client and ship nothing. See docs/analytics.md.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Explicit opt-in for handing POSTHOG_API_KEY + POSTHOG_HOST to the browser
# via /api/config so the frontend ships error/crash telemetry. Default OFF:
# a key configured for server-side use never silently turns visitors'
# browsers into telemetry shippers. Set to "true" to enable.
ANALYTICS_FRONTEND_ENABLED=
# Optional override for the `environment` PostHog event property.
# Defaults from APP_ENV and normalizes to production / staging / dev.
ANALYTICS_ENVIRONMENT=
# Force the no-op client even when POSTHOG_API_KEY is set (CI / opt-out).
ANALYTICS_DISABLED=

# ==================== Day-2 retention / GC (#439) ====================
# Read at startup; changing one needs a backend restart, not a rebuild.
# Values use Go duration syntax (s/m/h) — "d" is NOT a unit, so 30 days is
# "720h". An unparsable value logs a warning and falls back to the default.
#
# How long scheduler audit rows (sys_cron_executions) are kept. The scheduler
# writes one row per (job, scope, plan_time); with Autopilot on a 5-minute plan
# that is ~100k rows/month and, before #439, nothing ever deleted them.
# Set to 0 to keep every row forever.
GOOSAR_SCHEDULER_AUDIT_RETENTION=720h
# How long an uploaded attachment that is bound to NO issue / comment / chat
# message is left alone before the orphan sweep reclaims it and its stored
# object. The composer stores bytes before the owner row exists, and drafts
# live in the browser with no expiry, so this must outlast a draft someone
# comes back to after a long weekend. Set to 0 to disable the sweep.
GOOSAR_UPLOAD_GC_GRACE=168h
# How often both arms above run. Day-scale windows, so hourly is plenty.
GOOSAR_HYGIENE_SWEEP_INTERVAL=1h

# ==================== Container memory limits (#439) ====================
# Compose applies these as `mem_limit` on each service. Changing one needs
# `docker compose up -d` to RECREATE the container (a plain restart keeps the
# old cgroup) — no image rebuild. Defaults match the Helm chart's 1Gi limits.
# Keep the two runtime caps below their container limits so the runtime
# collects instead of being OOM-killed.
POSTGRES_MEM_LIMIT=1g
BACKEND_MEM_LIMIT=1g
BACKEND_GOMEMLIMIT=900MiB
FRONTEND_MEM_LIMIT=1g
FRONTEND_NODE_OPTIONS=--max-old-space-size=900

# ==================== Minimum daemon version (#439) ====================
# Oldest goosar CLI / daemon this server hands tasks to. A daemon below it has
# every claim refused with 426 daemon_too_old and logs an upgrade hint;
# registration, heartbeats and result reporting keep working. Re-read from the
# environment on every request, so no restart is needed beyond the one that
# changes it. Empty = the built-in floor (0.2.21, same as the quick-create
# gate); "none" disables the gate. Raise it after an upgrade that changes the
# task contract. A missing or unparsable client version is never refused — the
# header is client-controlled and best-effort.
GOOSAR_MIN_DAEMON_VERSION=

# ==================== Monitoring overlay (#396) ====================
# Used only by docker-compose.selfhost.monitoring.yml:
#   docker compose -f docker-compose.selfhost.yml \
#                  -f docker-compose.selfhost.monitoring.yml up -d
# Both ports bind 127.0.0.1 only; front them with the same reverse proxy you
# use for the app if they must be reachable off-host.
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
# Grafana admin password. `make selfhost` / scripts/install.sh generate one;
# compose refuses to start the overlay while this is empty, so the stack can
# never come up on Grafana's admin/admin default.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# How long Prometheus keeps samples on disk.
PROMETHEUS_RETENTION=15d
PROMETHEUS_MEM_LIMIT=1g
GRAFANA_MEM_LIMIT=512m
